# The personal identity is the default; the includeIf blocks at the bottom switch
# to the work identity for work repos. Keeping the identities in gitconfig-wrk /
# gitconfig-prs is what stops a work address landing in a public repo.
[include]
	path = ~/.gitconfig-prs
[core]
	editor = nvim
	pager = less -FRX
[alias]
	s = status
	b = branch
	co = checkout
	pr = pull --rebase
	ci = commit
	st = status

	l = log -C --decorate
	ls = log -C --stat --decorate
	lga = log --graph '--pretty=tformat:%Cblue%h%Creset %Cgreen%ar%Creset %Cblue%d%Creset %s' --all
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	slog = log --graph --all --topo-order --pretty='format:%h %ai %s%d (%an)'

	project-summary = !which onefetch && onefetch

	# https://gist.github.com/aclarknexient/0ffcb98aa262c585c49d4b3f3ae24019#git
	# Last 25 commits as a colourful tree
	lol = !git --no-pager log --graph --decorate --abbrev-commit --all --date=local -25 --pretty=format:\"%C(auto)%h%d %C(blue)%an %C(green)%cd %C(red)%GG %C(reset)%s\"
	# Pick changed files with fzf (TAB to toggle, ENTER to stage)
	fza = "!git ls-files -m -o --exclude-standard | fzf -m --print0 | xargs -0 git add"
	# Delete local branches whose remote is gone
	gone = "!f() { git fetch --all --prune; git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D; }; f"
[help]
	autocorrect = 20
[color]
	ui = auto
[push]
	default = simple
	followTags = true

# Work identity by location — covers a work repo with no remote yet.
[includeIf "gitdir/i:~/Documents/wrk/"]
	path = ~/.gitconfig-wrk

# Work identity by remote URL — covers a work repo cloned anywhere on disk. Both
# the https and ssh forms are needed; git matches the literal remote string.
[includeIf "hasconfig:remote.*.url:https://git.example.com/**"]
	path = ~/.gitconfig-wrk
[includeIf "hasconfig:remote.*.url:git@git.example.com:**"]
	path = ~/.gitconfig-wrk

# A personal remote wins over both, so a personal repo kept under wrk/ still gets
# the personal address. Last block listed = last one applied.
[includeIf "hasconfig:remote.*.url:https://github.com/XXX/**"]
	path = ~/.gitconfig-prs
[includeIf "hasconfig:remote.*.url:git@github.com:XXX/**"]
	path = ~/.gitconfig-prs
